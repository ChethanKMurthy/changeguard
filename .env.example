# Copy to .env (never commit .env). Every setting is optional for local use.

# Shared secret between the web app's API proxy and the engine. Set it whenever
# the engine is reachable by anyone but you; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHANGEGUARD_API_KEY=

# AI synthesis is off by default. Local and free:
#   CHANGEGUARD_AI_PROVIDER=ollama  CHANGEGUARD_AI_MODEL=llama3.2:3b
#   (docker compose --profile ai up, then: docker compose exec ollama ollama pull llama3.2:3b)
# Hosted (needs a key and is billed by the provider):
#   CHANGEGUARD_AI_PROVIDER=anthropic  CHANGEGUARD_AI_MODEL=claude-opus-5-5  CHANGEGUARD_AI_API_KEY=...
CHANGEGUARD_AI_PROVIDER=none
CHANGEGUARD_AI_MODEL=
CHANGEGUARD_AI_BASE_URL=
CHANGEGUARD_AI_API_KEY=

# "shared" lets everyone using the web app see every report (e.g. a team behind SSO).
# By default each browser only sees the analyses it created.
CHANGEGUARD_WORKSPACES=
